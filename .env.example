# ==============================================================================
# GreenShift Configuration Reference (.env.example)
# Authoritative definitions: PRD §17.2, prd-addendum.md §8
# ==============================================================================

# Core Database Configuration
# Local default uses SQLite file in current directory or /data in Docker
DATABASE_URL=sqlite:///./greenshift.db

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# Demo and Simulation Controls
# When true, unlocks simulated clock and demo simulation endpoints
DEMO_MODE=true
# Default simulation multiplier (120x: 1s = 2min; 288x: day-in-5-min)
SIM_SPEED=120

# Authentication and Authorization
# Enforces JWT/API-key validation. Can be false only when DEMO_MODE=true
AUTH_ENABLED=true
# Secret key used for signing HS256 JWT tokens (min 32 characters in production)
JWT_SECRET=ChangeMeInProductionSecretKey123!
# Master Fernet encryption key for encrypting forward proxy headers at rest (32 url-safe base64-encoded bytes)
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Bootstrap Admin Credentials
ADMIN_EMAIL=admin@greenshift.local
ADMIN_PASSWORD=AdminPassword123!

# Carbon Intensity Provider
# Options: 'neso' (live UK National Grid API) or 'mock' (deterministic synthetic curve)
CARBON_PROVIDER=mock
NESO_BASE_URL=https://api.carbonintensity.org.uk
RETENTION_DAYS=90

# Security and Forward Proxy Controls
# Set true only in air-gapped demo environments to allow non-HTTPS forward targets
ALLOW_HTTP_TARGETS=false
# Comma-separated whitelist of allowed target hostnames/domains ('*' allows any valid non-SSRF host)
FORWARD_ALLOWED_HOSTS=*
# Allowed CORS origins for the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scheduling and Optimization Engine
# Cluster capacity limit in kilowatts
CLUSTER_MAX_KW=100.0
# Leading-edge planning debounce coalescing window in milliseconds
PLANNING_DEBOUNCE_MS=200
# Solver hard timeout in seconds before fallback to greedy heuristic
SOLVER_TIMEOUT_SECONDS=5.0

# Logging
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
